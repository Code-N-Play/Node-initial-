                        </div>
                        
                        <div class="mb-4">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h5 class="mb-1">MSc Advanced Alien Biology</h5>
                                    <p class="text-primary">Dimension C-137 Institute of Technology</p>
                                </div>
                                <span class="text-muted">2002</span>
                            </div>
                        </div>
                        
                        <div>
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h5 class="mb-1">BSc in Everything Science</h5>
                                    <p class="text-primary">Earth Community College</p>
                                </div>
                                <span class="text-muted">1998</span>
                            </div>
                        </div>
                    </div>
