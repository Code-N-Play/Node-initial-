                    <button class="btn btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2" 
                            type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-palette-fill"></i>
                        <span>Theme</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end p-3">
                        <li>
                            <div class="d-flex gap-3 flex-wrap">
                                <div onclick="changeTheme('#3AAA64')" class="color-swatch" style="background: #3AAA64;" title="Green"></div>
                                <div onclick="changeTheme('#0d6efd')" class="color-swatch" style="background: #0d6efd;" title="Blue"></div>
                                <div onclick="changeTheme('#dc3545')" class="color-swatch" style="background: #dc3545;" title="Red"></div>
                                <div onclick="changeTheme('#6f42c1')" class="color-swatch" style="background: #6f42c1;" title="Purple"></div>
                                <div onclick="changeTheme('#fd7e14')" class="color-swatch" style="background: #fd7e14;" title="Orange"></div>
                                <div onclick="changeTheme('#198754')" class="color-swatch" style="background: #198754;" title="Teal"></div>
                                <div onclick="changeTheme('#6610f2')" class="color-swatch" style="background: #6610f2;" title="Indigo"></div>
                            </div>
                        </li>
                    </ul>
                </div>
                
                <button onclick="window.print()" class="btn btn-primary">
                    <i class="bi bi-printer-fill me-2"></i>Print / Save as PDF
