                            <div class="accent-line"></div>
                        </div>
                        
                        <div>
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="mb-1">Freelance Dimension Hopper</h5>
                                    <p class="text-primary fw-medium">Various Dimensions</p>
                                </div>
                                <span class="text-muted text-end">2000 – 2012</span>
                            </div>
                            <p class="text-muted">Independent contractor specializing in high-risk scientific expeditions.</p>
                        </div>
                    </div>
                </div>
            </div>
    
            <!-- Education -->
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h4 class="section-title">
                            <i class="bi bi-mortarboard-fill fs-3"></i> Education
                        </h4>
                        
                        <div class="mb-4">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h5 class="mb-1">PhD in Molecular Shwanky Physics</h5>
                                    <p class="text-primary">Jaarvlar-3 University</p>
                                </div>
                                <span class="text-muted">2004</span>
                            </div>
