        </div>
        
        <div class="text-center mt-5 pt-4 border-top">
          <small class="text-muted">Modern Bootstrap 5  • By <A href=https://nodws.com>Nodws</a></small>
        </div>
    </div>
    
    <script>
        function changeTheme(color) {
            document.documentElement.style.setProperty('--primary-color', color);
            
            // Force refresh of dynamic styles
            const styleSheets = document.styleSheets;
            for (let i = 0; i < styleSheets.length; i++) {
                if (styleSheets[i].href && styleSheets[i].href.includes('bootstrap')) {
                    continue; // Skip Bootstrap CSS
                }
            }
            
            // Re-trigger CSS updates
            document.querySelectorAll('.card, .btn-primary, .badge-primary, .text-primary, .social-btn').forEach(el => {
                el.style.transition = 'none';
                void el.offsetWidth;
                el.style.transition = '';
            });
        }
        
        // Print shortcut
        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                window.print();
            }
        });
        
        // Demo interaction
        document.querySelector('.profile-img').addEventListener('click', () => {
            alert("Wubba lubba dub dub! (I'm in great pain, please help me...)");
        });
    </script>
</body>
</html>